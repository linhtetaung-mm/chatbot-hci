# Private settings: copy through python3 setup_local.py. Never share .env.
CHATBOT_MODE=setup
ADMIN_KEY=replace-with-generated-secret
PORT=8766
# Blank selects a separate demo/live database automatically.
CHATBOT_DB=
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna
# Set blank for a model that does not support this parameter.
OPENAI_REASONING_EFFORT=none
RESEARCHER_CONTACT=
SUPPORT_CONTACTS=Ask your supervising researcher for local support contacts.
DELETE_DATE=2026-12-19
# Set confirmed only after the applicable course review for human testing.
HUMAN_TEST_REVIEW=

# Hosting: leave blank for localhost. Render normally auto-detects its HTTPS URL.
PUBLIC_ORIGIN=
DEPLOYMENT=local
# Limits apply across both chatbot styles; UTC daily reset. Summary/retry attempts count.
TESTER_DAILY_API_LIMIT=50
GLOBAL_DAILY_API_LIMIT=250
GLOBAL_TOTAL_API_LIMIT=500
TESTER_MINUTE_API_LIMIT=3
GLOBAL_CONCURRENT_API_LIMIT=5
TESTER_DAILY_CHAT_LIMIT=4

# temporary keeps working state in process RAM; no saved memories or exports.
STORAGE_MODE=temporary

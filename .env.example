# Private settings: copy through python3 setup_local.py. Never share .env.
CHATBOT_MODE=setup
ADMIN_KEY=replace-with-generated-secret
PORT=8766
# Blank selects a separate demo/live database automatically.
CHATBOT_DB=
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-6-luna
# Set blank for a model that does not support this parameter.
OPENAI_REASONING_EFFORT=none
RESEARCHER_CONTACT=
SUPPORT_CONTACTS=Thailand Mental Health Hotline 1323 (24 hours) · AIT student counselling: ADD VERIFIED CONTACT
DELETE_DATE=2026-12-19
# Set confirmed only after the applicable course review for human testing.
HUMAN_TEST_REVIEW=

# Hosting: leave blank for localhost. Render normally auto-detects its HTTPS URL.
PUBLIC_ORIGIN=
DEPLOYMENT=local
# Limits apply across both chatbot styles; UTC daily reset. Summary/retry attempts count.
TESTER_DAILY_API_LIMIT=80
GLOBAL_DAILY_API_LIMIT=800
GLOBAL_TOTAL_API_LIMIT=3000
TESTER_MINUTE_API_LIMIT=6
GLOBAL_CONCURRENT_API_LIMIT=5
TESTER_DAILY_CHAT_LIMIT=6

# temporary keeps working state in process RAM; no saved memories or exports.
STORAGE_MODE=temporary

# Supabase / PostgreSQL (server-side only; never commit or share this file).
# After filling DATABASE_URL, set DATABASE_BACKEND=supabase AND STORAGE_MODE=persistent.
# Keep the existing CHATBOT_MODE and OPENAI_API_KEY settings.
DATABASE_BACKEND=sqlite
DATABASE_URL=PASTE_YOUR_SUPABASE_SESSION_POOLER_URL_HERE
# Blank selects hci_live / hci_demo / hci_setup according to CHATBOT_MODE.
DATABASE_SCHEMA=
# TLS verifies the hostname and certificate. If system trust fails, download
# the project CA certificate from Supabase and set its absolute local path here.
DATABASE_SSLROOTCERT=system

# Study settings
# How long a participant stays signed in on their own device (hours; 168 = 7 days).
SESSION_HOURS=168
# Minimum participant messages before Finish in the first and final guided chats.
MIN_GUIDED_MESSAGES=6
